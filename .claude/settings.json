{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node --check:*)",
      "Bash(python3 -I .claude/hooks/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(curl -s -o /dev/null -w:*)"
    ]
  }
}
